    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF2A2140"
                android:endColor="#FF14111D" />
        </aapt:attr>
    </path>
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="46">
                <item android:offset="0" android:color="#73F4B740" />
                <item android:offset="0.55" android:color="#1FF4B740" />
                <item android:offset="1" android:color="#00F4B740" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
