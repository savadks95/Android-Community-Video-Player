<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon background (108dp adaptive canvas): the velvet stage, lit by a soft projector-amber glow
     behind the mark, like the launch intro. Fills the whole canvas, since launchers mask and move it. -->
